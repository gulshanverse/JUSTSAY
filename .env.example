# ==========================================
# JUSTSAY PRODUCTION ENVIRONMENT TEMPLATE
# ==========================================
# Copy this file to .env and configure real production secrets prior to deployment.

# Node Server Environment
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# Security & Secrets (MUST be at least 32 characters in production)
SESSION_SECRET=your_production_session_secret_min_32_characters_long
ADMIN_SECRET=your_production_admin_secret_min_32_characters_long

# Managed Database (PostgreSQL 15+)
DATABASE_URL=postgresql://justsay_user:your_secure_password@postgres-host:5432/justsay_prod?sslmode=require
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_SSL=true

# Managed Redis Cache (Redis 7+)
REDIS_URL=rediss://default:your_redis_password@redis-host:6379
REDIS_KEY_PREFIX=justsay:
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=3

# Cloud Object Storage (GCS or S3)
STORAGE_PROVIDER=gcs
OBJECT_STORAGE_BUCKET=justsay-media-assets-prod
OBJECT_STORAGE_REGION=us-central1
STORAGE_SIGNED_URL_TTL=3600

# Firebase Cloud Messaging (FCM Push Notifications)
FCM_ENABLED=true
FCM_PROJECT_ID=justsay-prod-firebase
FCM_CLIENT_EMAIL=firebase-adminsdk@justsay-prod.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# AI Moderation Settings
MODERATION_PROVIDER=keyword
MODERATION_AUTO_BLOCK_THRESHOLD=0.85

# Optional Gemini API Key (Injected automatically in Google AI Studio when enabled)
# GEMINI_API_KEY=your_gemini_api_key_here
